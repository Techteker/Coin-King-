{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with balance and referral information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "balance": { "type": "number", "description": "Current coin balance" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string", "description": "UID of the user who referred this user" },
        "lastDailyClaim": { "type": "string", "format": "date-time" },
        "dailyStreak": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "balance", "referralCode"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Withdrawal request from a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number", "description": "Amount in coins" },
        "method": { "type": "string", "enum": ["paytm", "phonepe", "paypal"] },
        "accountDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "method", "accountDetails", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Ledger of coin changes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["spin", "daily", "referral", "withdraw"] },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Withdrawal requests"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "History of all coin transactions"
    }
  }
}
